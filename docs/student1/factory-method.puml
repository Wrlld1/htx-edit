@startuml
!pragma layout smetana
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam defaultFontSize 13
skinparam classAttributeIconSize 0
skinparam ArrowColor #344563
skinparam packageBorderColor #344563
skinparam packageFontColor #344563
skinparam packageStyle folder
skinparam class {
  BackgroundColor white
  HeaderBackgroundColor #EFF4FA
  BorderColor #344563
  FontColor #25344B
}
skinparam rectangle {
  BackgroundColor<<builderGroup>> #F0FDF5
  BorderColor<<builderGroup>> #33CC77
  FontColor<<builderGroup>> #166534
  BorderStyle<<builderGroup>> dashed
  BackgroundColor<<factoryGroup>> #EFF6FF
  BorderColor<<factoryGroup>> #60A5FA
  FontColor<<factoryGroup>> #1E40AF
  BorderStyle<<factoryGroup>> dashed
  BackgroundColor<<fileGroup>> #F8FAFC
  BorderColor<<fileGroup>> #94A3B8
  FontColor<<fileGroup>> #475569
  BorderStyle<<fileGroup>> dashed
}
hide <<builderGroup>> stereotype
hide <<factoryGroup>> stereotype
hide <<fileGroup>> stereotype

package kz {
  package texteditor {
    package export {
      rectangle "Factory Method Pattern (Creational)" <<factoryGroup>> {
        abstract class ExportJob <<abstract, Creator>> {
          +export(text: String, path: Path): void {final}
          #{abstract} createExporter(): TextExporter
        }
        class TxtExportJob <<ConcreteCreator>> {
          #createExporter(): TextExporter
        }
        class HtmlExportJob <<ConcreteCreator>> {
          #createExporter(): TextExporter
        }
        interface TextExporter <<interface, Product>> {
          +write(text: String, path: Path): void
        }
        class TxtExporter <<ConcreteProduct>> {
          -fileService: FileService {readOnly}
          --
          +write(text: String, path: Path): void
        }
        class HtmlExporter <<ConcreteProduct>> {
          -fileService: FileService {readOnly}
          --
          +write(text: String, path: Path): void
        }
      }
    }
    package service {
      rectangle "UTF-8 File Operations" <<fileGroup>> {
        class FileService {
          +read(path: Path): String
          +write(text: String, path: Path): void
          +exists(path: Path): boolean
        }
      }
    }
  }
}

ExportJob <|-- TxtExportJob
ExportJob <|-- HtmlExportJob
ExportJob ..> TextExporter : <<uses>>
TxtExportJob ..> TxtExporter : <<creates>>
HtmlExportJob ..> HtmlExporter : <<creates>>
TextExporter <|.. TxtExporter
TextExporter <|.. HtmlExporter
TxtExporter --> FileService : -fileService
HtmlExporter --> FileService : -fileService
@enduml
