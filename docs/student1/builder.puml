@startuml
!pragma layout smetana
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam defaultFontSize 13
skinparam classAttributeIconSize 0
skinparam ArrowColor #344563
skinparam packageBorderColor #344563
skinparam packageFontColor #344563
skinparam packageStyle folder
skinparam class {
  BackgroundColor white
  HeaderBackgroundColor #EFF4FA
  BorderColor #344563
  FontColor #25344B
}
skinparam rectangle {
  BackgroundColor<<builderGroup>> #F0FDF5
  BorderColor<<builderGroup>> #33CC77
  FontColor<<builderGroup>> #166534
  BorderStyle<<builderGroup>> dashed
  BackgroundColor<<factoryGroup>> #EFF6FF
  BorderColor<<factoryGroup>> #60A5FA
  FontColor<<factoryGroup>> #1E40AF
  BorderStyle<<factoryGroup>> dashed
  BackgroundColor<<fileGroup>> #F8FAFC
  BorderColor<<fileGroup>> #94A3B8
  FontColor<<fileGroup>> #475569
  BorderStyle<<fileGroup>> dashed
}
hide <<builderGroup>> stereotype
hide <<factoryGroup>> stereotype
hide <<fileGroup>> stereotype

package kz {
  package texteditor {
    package processing {
      rectangle "Builder Pattern (Creational)" <<builderGroup>> {
        class "ProcessingOptions.Builder" as Builder <<Builder>> {
          -removeExtraSpaces: boolean = false
          -fixPunctuation: boolean = false
          -trimQuotes: boolean = false
          -caseMode: CaseMode = KEEP
          --
          +removeExtraSpaces(enabled: boolean): Builder
          +fixPunctuation(enabled: boolean): Builder
          +trimQuotes(enabled: boolean): Builder
          +caseMode(mode: CaseMode): Builder
          +build(): ProcessingOptions
        }
        class ProcessingOptions <<record, Product>> {
          -removeExtraSpaces: boolean {readOnly}
          -fixPunctuation: boolean {readOnly}
          -trimQuotes: boolean {readOnly}
          -caseMode: CaseMode {readOnly}
          --
          +{static} builder(): Builder
          +{static} defaults(): ProcessingOptions
          +toBuilder(): Builder
          +removeExtraSpaces(): boolean
          +fixPunctuation(): boolean
          +trimQuotes(): boolean
          +caseMode(): CaseMode
        }
        enum CaseMode <<enumeration>> {
          KEEP
          UPPER
          LOWER
        }
      }
    }

  }
}

Builder ..> ProcessingOptions : <<creates>>
ProcessingOptions --> CaseMode : -caseMode
Builder --> CaseMode : -caseMode
@enduml
